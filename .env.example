# Copy to .env (or .env.local) and fill in. Both are git-ignored.

# Better Auth: signs session cookies. Generate with: bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=
# Public URL of the app (used by Better Auth for callbacks and trusted origins)
BETTER_AUTH_URL=http://localhost:3000

# First owner account, created on first start when no accounts exist; ignored after that.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD= 1234567890

# Storage (optional, defaults shown)
DATABASE_PATH=.data/oraia.sqlite
UPLOAD_DIR=.data/uploads
